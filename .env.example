# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.
ANTHROPIC_API_KEY=

# Optional: serve the retail example's search from an Algolia index (see examples/retail/README.md).
# The API reads the search-only key; only scripts/load_algolia.py reads the admin key.
ALGOLIA_APP_ID=
ALGOLIA_INDEX=
ALGOLIA_SEARCH_KEY=
ALGOLIA_ADMIN_KEY=

# Optional: send each retail chat turn to LangSmith as one trace (demo_common/tracing.py).
# A trace holds the conversation, customer text included.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=

# Optional: verify TLS against the Windows/macOS certificate store, for a proxy that re-signs HTTPS.
DEMO_USE_SYSTEM_CERTS=
